<!DOCTYPE html>
<html>
  <head>
    <title>Job Seekers</title>
    <link
      rel="stylesheet"
      type="text/css"
      href="../public/stylesheets/style.css"
    />
  </head>
  <body>
    <h1>Job Seekers</h1>
    <table>
      <thead>
        <tr>
          <th>Seeker ID</th>
          <th>Name</th>
          <th>Birth Date</th>
          <th>Address</th>
          <th>City</th>
          <th>Country</th>
        </tr>
      </thead>
      <tbody>
        <% jobSeeker.forEach(function(jobSeeker) { %>
        <tr>
          <td><%= jobSeeker.seeker_id %></td>
          <td><%= jobSeeker.name %></td>
          <td><%= jobSeeker.birth_date %></td>
          <td><%= jobSeeker.address %></td>
          <td><%= jobSeeker.city %></td>
          <td><%= jobSeeker.country %></td>
        </tr>
        <% }); %>
      </tbody>
    </table>
  </body>
</html>
